[app]
title = Futebol Simulator 2K26
package.name = futebol2k26
package.domain = org.futebol
source.dir = .
source.include_exts = py,png,jpg,kv,json
version = 1.0
requirements = python3,kivy==2.3.0
orientation = portrait
fullscreen = 0
